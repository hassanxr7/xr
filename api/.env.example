# Local development only. Copy to .env and adjust; never commit the real file.
# In the Docker deployment, DATABASE_URL is instead composed from
# deployment/.env by docker-compose.yml -- you don't edit it there directly.

DATABASE_URL="postgresql://smsbridge:smsbridge@localhost:5432/smsbridge?schema=public"
PORT=3001
NODE_ENV=development

# Same-origin dev is recommended (see web/next.config.ts's API_PROXY_ORIGIN
# rewrite); only set CORS_ORIGIN if you're deliberately running the web app
# on a different origin without that proxy.
# CORS_ORIGIN=http://localhost:3000

# Optional request-rate limits for /auth/login and /devices/pair.
# LOGIN_RATE_LIMIT=5
# PAIR_RATE_LIMIT=10

# Optional global per-IP limit (requests/minute) applied to every route as a
# safety net. Raise this if a dashboard actively polling a very large inbox
# (100k+ messages) or a load test trips it; the login/pair limits above are
# what actually matters for resisting credential/code guessing.
# GLOBAL_RATE_LIMIT=120

# Never set SEED_DEMO_DATA=true against a real/production database -- it
# unlocks the demo/perf seed scripts, which insert synthetic messages.
# SEED_DEMO_DATA=true
