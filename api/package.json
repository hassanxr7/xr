{
  "name": "smsbridge-api",
  "version": "1.0.0",
  "description": "SMSBridge backend API (NestJS + Prisma + PostgreSQL)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "owner:create": "ts-node -r tsconfig-paths/register src/scripts/create-owner.ts",
    "owner:reset-password": "ts-node -r tsconfig-paths/register src/scripts/reset-owner-password.ts",
    "seed:demo": "ts-node -r tsconfig-paths/register src/scripts/seed-demo.ts",
    "seed:perf": "ts-node -r tsconfig-paths/register src/scripts/seed-perf.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.3",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.2",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.3",
    "@types/uuid": "10.0.0",
    "jest": "30.2.0",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "multer": "2.3.0",
    "mysql2": "3.24.4",
    "deepmerge-ts": "8.0.2"
  }
}
