# Copy this file to deployment/.env and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# --- PostgreSQL (internal only; not reachable from outside the compose network) ---
POSTGRES_USER=smsbridge
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=smsbridge

# --- Domain / HTTPS ---
# The domain (or "sub.example.com") that points at this server's public IP.
# Caddy automatically obtains and renews a Let's Encrypt certificate for it.
# For a first local test without a real domain, you can use a local IP with
# a self-signed cert instead -- see deployment/README.md.
SMSBRIDGE_DOMAIN=smsbridge.example.com

# --- Branding (optional) ---
# Shown in the dashboard title/sidebar. Change to rebrand without touching code.
BRAND_NAME=SMSBridge

# --- Rate limits (optional, sane defaults if omitted) ---
LOGIN_RATE_LIMIT=5
PAIR_RATE_LIMIT=10
GLOBAL_RATE_LIMIT=120
