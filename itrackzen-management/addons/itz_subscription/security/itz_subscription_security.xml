<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_itz_subscription_all" model="ir.rule">
        <field name="name">ITrackZen staff: all subscriptions</field>
        <field name="model_id" ref="model_itz_subscription"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('itz_base.group_itz_see_all'))]"/>
    </record>
    <record id="rule_itz_subscription_period_all" model="ir.rule">
        <field name="name">ITrackZen staff: all billing periods</field>
        <field name="model_id" ref="model_itz_subscription_period"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('itz_base.group_itz_see_all'))]"/>
    </record>
</odoo>
