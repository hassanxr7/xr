<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_itz_subscription_billing" model="ir.cron">
        <field name="name">ITrackZen: create renewal invoices</field>
        <field name="model_id" ref="model_itz_subscription"/>
        <field name="state">code</field>
        <field name="code">model._cron_billing()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_itz_subscription_reminders" model="ir.cron">
        <field name="name">ITrackZen: renewal reminders</field>
        <field name="model_id" ref="model_itz_subscription"/>
        <field name="state">code</field>
        <field name="code">model._cron_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_itz_subscription_expire" model="ir.cron">
        <field name="name">ITrackZen: expire unpaid subscriptions</field>
        <field name="model_id" ref="model_itz_subscription"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
