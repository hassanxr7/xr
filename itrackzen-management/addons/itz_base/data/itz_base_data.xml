<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Every internal user gets lots/serial numbers and multi-location features enabled by dependent modules -->
    <record id="seq_itz_audit" model="ir.sequence">
        <field name="name">ITZ Audit</field>
        <field name="code">itz.audit.log</field>
        <field name="prefix">LOG</field>
        <field name="padding">7</field>
    </record>
    <!-- The first administrator becomes the Owner / Super Admin of the ITrackZen workspace -->
    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[Command.link(ref('itz_base.group_itz_owner'))]"/>
    </record>
    <record id="base.user_root" model="res.users">
        <field name="groups_id" eval="[Command.link(ref('itz_base.group_itz_owner'))]"/>
    </record>
</odoo>
