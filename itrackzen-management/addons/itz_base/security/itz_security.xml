<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Categories ============ -->
    <record id="module_category_itz" model="ir.module.category">
        <field name="name">ITrackZen Roles</field>
        <field name="description">Staff roles for the ITrackZen Management System. A user can hold several roles.</field>
        <field name="sequence">5</field>
    </record>
    <record id="module_category_itz_privileges" model="ir.module.category">
        <field name="name">ITrackZen Privileges</field>
        <field name="description">Extra permissions that can be added to any role.</field>
        <field name="sequence">6</field>
    </record>

    <!-- ============ Privileges (add-ons to roles) ============ -->
    <record id="group_itz_financial" model="res.groups">
        <field name="name">Financial information</field>
        <field name="category_id" ref="module_category_itz_privileges"/>
        <field name="comment">See costs, margins, invoices, payments, balances and statements.</field>
    </record>
    <record id="group_itz_approver" model="res.groups">
        <field name="name">Approve quotations and requests</field>
        <field name="category_id" ref="module_category_itz_privileges"/>
        <field name="comment">Approve or reject quotations and other requests.</field>
    </record>
    <record id="group_itz_delete" model="res.groups">
        <field name="name">Delete records</field>
        <field name="category_id" ref="module_category_itz_privileges"/>
        <field name="comment">Delete ITrackZen records (vehicles, installations, SIMs, subscriptions...). Stock and accounting records can never be deleted from the interface.</field>
    </record>
    <record id="group_itz_export" model="res.groups">
        <field name="name">Export data</field>
        <field name="category_id" ref="module_category_itz_privileges"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_allow_export'))]"/>
        <field name="comment">Use list exports and the Excel/PDF report exports.</field>
    </record>

    <!-- ============ Roles ============ -->
    <record id="group_itz_readonly" model="res.groups">
        <field name="name">Read-only user</field>
        <field name="category_id" ref="module_category_itz"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Can view ITrackZen records but cannot create, edit or delete.</field>
    </record>
    <record id="group_itz_technician" model="res.groups">
        <field name="name">Installation Technician</field>
        <field name="category_id" ref="module_category_itz"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Sees only assigned installations, tasks and equipment issued to them. No financial information.</field>
    </record>
    <record id="group_itz_support" model="res.groups">
        <field name="name">Customer Support</field>
        <field name="category_id" ref="module_category_itz"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('base.group_partner_manager'))]"/>
        <field name="comment">Manages customers, vehicles, service history and support tasks.</field>
    </record>
    <record id="group_itz_sales" model="res.groups">
        <field name="name">Sales Officer</field>
        <field name="category_id" ref="module_category_itz"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('base.group_partner_manager'))]"/>
        <field name="comment">Creates customers, vehicles and quotations. Sees own quotations.</field>
    </record>
    <record id="group_itz_storekeeper" model="res.groups">
        <field name="name">Storekeeper</field>
        <field name="category_id" ref="module_category_itz"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Receives stock, manages devices and SIMs, issues equipment to technicians.</field>
    </record>
    <record id="group_itz_accountant" model="res.groups">
        <field name="name">Accountant / Cashier</field>
        <field name="category_id" ref="module_category_itz"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('group_itz_financial')), Command.link(ref('group_itz_export'))]"/>
        <field name="comment">Issues invoices, records payments, prints receipts and statements.</field>
    </record>
    <record id="group_itz_ops_manager" model="res.groups">
        <field name="name">Operations Manager</field>
        <field name="category_id" ref="module_category_itz"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('group_itz_financial')), Command.link(ref('group_itz_approver')), Command.link(ref('group_itz_export')), Command.link(ref('group_itz_delete')), Command.link(ref('base.group_partner_manager'))]"/>
        <field name="comment">Oversees sales, stock, installations, tasks and staff. Approves quotations.</field>
    </record>
    <record id="group_itz_owner" model="res.groups">
        <field name="name">Owner / Super Admin</field>
        <field name="category_id" ref="module_category_itz"/>
        <field name="implied_ids" eval="[Command.link(ref('group_itz_ops_manager')), Command.link(ref('group_itz_sales')), Command.link(ref('group_itz_storekeeper')), Command.link(ref('group_itz_accountant')), Command.link(ref('group_itz_support')), Command.link(ref('base.group_system'))]"/>
        <field name="comment">Full access including users, roles, settings and the activity log.</field>
    </record>


    <!-- Hidden helper group: every role except Installation Technician. Used by record rules ("see all" vs "see own"). -->
    <record id="group_itz_see_all" model="res.groups">
        <field name="name">ITrackZen: sees all records</field>
        <field name="comment">Technical group, assigned automatically through the roles. Do not assign by hand.</field>
    </record>
    <record id="group_itz_readonly" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_itz_see_all'))]"/>
    </record>
    <record id="group_itz_support" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_itz_see_all'))]"/>
    </record>
    <record id="group_itz_sales" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_itz_see_all'))]"/>
    </record>
    <record id="group_itz_storekeeper" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_itz_see_all'))]"/>
    </record>
    <record id="group_itz_accountant" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_itz_see_all'))]"/>
    </record>
    <record id="group_itz_ops_manager" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_itz_see_all'))]"/>
    </record>

    <!-- Audit log is read-only for everyone; only owner and operations manager can read it -->
    <record id="rule_itz_audit_log_read" model="ir.rule">
        <field name="name">ITZ audit log: read only</field>
        <field name="model_id" ref="model_itz_audit_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_itz_owner')), Command.link(ref('group_itz_ops_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
