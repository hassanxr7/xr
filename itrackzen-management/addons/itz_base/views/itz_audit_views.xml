<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_itz_audit_log_list" model="ir.ui.view">
        <field name="name">itz.audit.log.list</field>
        <field name="model">itz.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="id desc">
                <field name="date"/>
                <field name="user_id"/>
                <field name="category" widget="badge"/>
                <field name="action"/>
                <field name="record_ref"/>
                <field name="detail"/>
                <field name="ip_address" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_itz_audit_log_form" model="ir.ui.view">
        <field name="name">itz.audit.log.form</field>
        <field name="model">itz.audit.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="category"/>
                            <field name="action"/>
                        </group>
                        <group>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="record_ref"/>
                            <field name="ip_address"/>
                        </group>
                    </group>
                    <field name="detail"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_itz_audit_log_search" model="ir.ui.view">
        <field name="name">itz.audit.log.search</field>
        <field name="model">itz.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="record_ref"/>
                <field name="user_id"/>
                <field name="action"/>
                <field name="detail"/>
                <filter name="f_stock" string="Stock" domain="[('category', '=', 'stock')]"/>
                <filter name="f_payment" string="Payments" domain="[('category', '=', 'payment')]"/>
                <filter name="f_approval" string="Approvals" domain="[('category', '=', 'approval')]"/>
                <filter name="f_permission" string="Permissions" domain="[('category', '=', 'permission')]"/>
                <filter name="f_install" string="Installations" domain="[('category', '=', 'installation')]"/>
                <filter name="f_sub" string="Subscriptions" domain="[('category', '=', 'subscription')]"/>
                <filter name="f_integration" string="Integration" domain="[('category', '=', 'integration')]"/>
                <separator/>
                <filter name="f_today" string="Today" domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Group By">
                    <filter name="g_cat" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="g_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="g_day" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_itz_audit_log" model="ir.actions.act_window">
        <field name="name">Activity Log</field>
        <field name="res_model">itz.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_itz_audit_log_search"/>
    </record>
</odoo>
