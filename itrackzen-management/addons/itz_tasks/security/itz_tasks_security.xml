<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="itz_base.group_itz_ops_manager" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('hr.group_hr_user'))]"/>
    </record>
    <record id="itz_base.group_itz_owner" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('hr.group_hr_manager'))]"/>
    </record>
    <!-- Technicians: only tasks assigned to them. They may create tasks for themselves (e.g. a note to follow up). -->
    <record id="rule_itz_task_technician" model="ir.rule">
        <field name="name">Technician: own tasks</field>
        <field name="model_id" ref="model_itz_task"/>
        <field name="domain_force">['|', ('assigned_user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('itz_base.group_itz_technician'))]"/>
    </record>
    <!-- Other staff: tasks they own, created or follow -->
    <record id="rule_itz_task_staff" model="ir.rule">
        <field name="name">Staff: own, created or followed tasks</field>
        <field name="model_id" ref="model_itz_task"/>
        <field name="domain_force">['|', '|', ('assigned_user_id', '=', user.id), ('create_uid', '=', user.id), ('message_partner_ids', 'in', [user.partner_id.id])]</field>
        <field name="groups" eval="[Command.link(ref('itz_base.group_itz_sales')), Command.link(ref('itz_base.group_itz_support')), Command.link(ref('itz_base.group_itz_storekeeper')), Command.link(ref('itz_base.group_itz_accountant'))]"/>
    </record>
    <record id="rule_itz_task_managers" model="ir.rule">
        <field name="name">Managers and read-only: all tasks</field>
        <field name="model_id" ref="model_itz_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('itz_base.group_itz_ops_manager')), Command.link(ref('itz_base.group_itz_readonly'))]"/>
    </record>
    <!-- A technician also sees the customers and vehicles of tasks assigned to them -->
    <record id="rule_partner_technician_tasks" model="ir.rule">
        <field name="name">Technician: customers of own tasks</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('itz_task_ids.assigned_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('itz_base.group_itz_technician'))]"/>
    </record>
    <record id="rule_vehicle_technician_tasks" model="ir.rule">
        <field name="name">Technician: vehicles of own tasks</field>
        <field name="model_id" ref="itz_fleet.model_itz_vehicle"/>
        <field name="domain_force">[('itz_task_ids.assigned_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('itz_base.group_itz_technician'))]"/>
    </record>
</odoo>
