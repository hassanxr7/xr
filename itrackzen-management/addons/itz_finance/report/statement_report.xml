<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_statement" model="ir.actions.report">
        <field name="name">Customer Statement</field>
        <field name="model">itz.statement.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">itz_finance.report_statement</field>
        <field name="report_file">itz_finance.report_statement</field>
        <field name="print_report_name">'Statement - %s' % object.partner_id.name</field>
    </record>

    <template id="report_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="data" t-value="o._get_data()"/>
                <t t-set="company" t-value="o.company_id"/>
                <t t-call="web.external_layout">
                    <t t-set="doc" t-value="o.with_context(lang=o.partner_id.lang)"/>
                    <div class="page">
                        <div class="row mb-3">
                            <div class="col-7">
                                <h2 style="color:#111111;">Statement of Account</h2>
                                <div>Period: <span t-field="o.date_from"/> to <span t-field="o.date_to"/></div>
                            </div>
                            <div class="col-5">
                                <strong t-field="o.partner_id.name"/>
                                <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "phone"], "no_marker": true}'/>
                            </div>
                        </div>
                        <table class="table table-sm o_main_table">
                            <thead style="background:#111111;">
                                <tr style="color:#ffffff;">
                                    <th style="color:#fff;">Date</th><th style="color:#fff;">Reference</th><th style="color:#fff;">Description</th><th style="color:#fff;">Due</th>
                                    <th class="text-end" style="color:#fff;">Charges</th><th class="text-end" style="color:#fff;">Payments</th><th class="text-end" style="color:#fff;">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="font-weight:bold;">
                                    <td colspan="6">Opening balance</td>
                                    <td class="text-end"><span t-out="data['opening']" t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/></td>
                                </tr>
                                <tr t-foreach="data['rows']" t-as="r">
                                    <td><span t-out="r['date']" t-options="{'widget': 'date'}"/></td>
                                    <td><span t-out="r['ref']"/></td>
                                    <td><span t-out="r['description']"/></td>
                                    <td><span t-if="r['due']" t-out="r['due']" t-options="{'widget': 'date'}"/></td>
                                    <td class="text-end"><span t-if="r['debit']" t-out="r['debit']" t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/></td>
                                    <td class="text-end"><span t-if="r['credit']" t-out="r['credit']" t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/></td>
                                    <td class="text-end"><span t-out="r['balance']" t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/></td>
                                </tr>
                                <tr style="font-weight:bold;border-top:2px solid #111111;">
                                    <td colspan="4">Closing balance</td>
                                    <td class="text-end"><span t-out="data['total_debit']" t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/></td>
                                    <td class="text-end"><span t-out="data['total_credit']" t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/></td>
                                    <td class="text-end"><span t-out="data['closing']" t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <h5 class="mt-4" style="color:#111111;">Ageing of amounts due</h5>
                        <table class="table table-sm" style="max-width:100%;">
                            <thead><tr>
                                <th class="text-end">Not yet due</th><th class="text-end">1-30 days</th><th class="text-end">31-60 days</th>
                                <th class="text-end">61-90 days</th><th class="text-end">Over 90 days</th>
                            </tr></thead>
                            <tbody><tr>
                                <td t-foreach="data['ageing'].values()" t-as="amt" class="text-end">
                                    <span t-out="amt" t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/>
                                </td>
                            </tr></tbody>
                        </table>
                        <div t-if="company.itz_payment_instructions" class="mt-4">
                            <strong>How to pay</strong>
                            <div t-field="company.itz_payment_instructions"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
