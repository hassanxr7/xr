<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_itz_finance" model="ir.ui.view">
        <field name="name">res.company.form.itz.finance</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="itz_base.view_company_form_itz"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='itz_settings']/group" position="inside">
                <group string="Documents">
                    <field name="itz_payment_instructions"/>
                    <field name="itz_terms_note"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
