<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="itz_statement_wizard_form" model="ir.ui.view">
        <field name="name">itz.statement.wizard.form</field>
        <field name="model">itz.statement.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group><field name="partner_id" options="{'no_create': True}"/><field name="only_open"/></group>
                    <group><field name="date_from"/><field name="date_to"/><field name="company_id" groups="base.group_multi_company"/></group>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print statement (PDF)" class="btn-primary"/>
                    <button name="action_send" type="object" string="Email to customer" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_itz_statement_wizard" model="ir.actions.act_window">
        <field name="name">Customer Statement</field>
        <field name="res_model">itz.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
