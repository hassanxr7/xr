<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="itz_presence_list" model="ir.ui.view">
        <field name="name">itz.presence.list</field>
        <field name="model">itz.presence</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="date desc, user_id">
                <field name="date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="hours" widget="float_time" sum="Total"/>
                <field name="first_seen"/>
                <field name="last_seen"/>
            </list>
        </field>
    </record>
    <record id="itz_presence_search" model="ir.ui.view">
        <field name="name">itz.presence.search</field>
        <field name="model">itz.presence</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <filter name="f_today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="f_week" string="This week" domain="[('date', '&gt;=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter name="f_month" string="This month" domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <group expand="0" string="Group By">
                    <filter name="g_user" string="Person" context="{'group_by': 'user_id'}"/>
                    <filter name="g_date" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_itz_presence" model="ir.actions.act_window">
        <field name="name">Hours Online</field>
        <field name="res_model">itz.presence</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_f_week': 1, 'search_default_g_user': 1}</field>
    </record>
    <menuitem id="menu_itz_presence" name="Hours Online" parent="itz_tasks.menu_itz_people" sequence="40" action="action_itz_presence"
              groups="itz_base.group_itz_ops_manager"/>
</odoo>
