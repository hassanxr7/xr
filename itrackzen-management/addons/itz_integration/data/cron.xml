<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_itz_sync_queue" model="ir.cron">
        <field name="name">ITrackZen: send queued changes to the tracking platform</field>
        <field name="model_id" ref="model_itz_sync_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="platform_config_default" model="itz.platform.config">
        <field name="mode">disabled</field>
    </record>
</odoo>
