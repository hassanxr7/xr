<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="itz_website_config_form" model="ir.ui.view">
        <field name="name">itz.website.config.form</field>
        <field name="model">itz.website.config</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        The website admin area at <strong>/admin/</strong> signs staff in through this system. People sign in once here, with their own login and role,
                        and the website shows only the sections their role allows. Copy the shared secret into <code>includes/config.local.php</code> on the website as <code>ODOO_SSO_SECRET</code>.
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="enabled"/>
                            <field name="website_url"/>
                            <field name="admin_url"/>
                            <field name="allowed_redirects"/>
                        </group>
                        <group string="Security">
                            <field name="shared_secret" password="True" groups="itz_base.group_itz_owner"/>
                            <button name="action_regenerate_secret" type="object" string="Create a new secret" class="btn-link"
                                    groups="itz_base.group_itz_owner" confirm="The website stops signing in until it has the new secret. Continue?"/>
                        </group>
                        <group string="Enquiries and deletion requests">
                            <field name="accept_events"/>
                            <field name="default_sales_user_id"/>
                            <field name="default_support_user_id"/>
                            <field name="deletion_deadline_days"/>
                            <field name="last_event_at"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="itz_website_config_list" model="ir.ui.view">
        <field name="name">itz.website.config.list</field>
        <field name="model">itz.website.config</field>
        <field name="arch" type="xml">
            <list create="0" delete="0"><field name="name"/><field name="enabled"/><field name="website_url"/><field name="last_event_at"/></list>
        </field>
    </record>
    <record id="action_itz_website_config_window" model="ir.actions.act_window">
        <field name="name">Website Connection</field>
        <field name="res_model">itz.website.config</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="itz_website_event_list" model="ir.ui.view">
        <field name="name">itz.website.event.list</field>
        <field name="model">itz.website.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0"><field name="create_date"/><field name="event_type"/><field name="event_id"/><field name="state" widget="badge"/><field name="note"/></list>
        </field>
    </record>
    <record id="action_itz_website_events" model="ir.actions.act_window">
        <field name="name">Website Events</field>
        <field name="res_model">itz.website.event</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
