<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_itz" inherit_id="sale.report_saleorder_document" name="ITrackZen quotation additions">
        <!-- Vehicle under each line -->
        <xpath expr="//td[@name='td_name']" position="inside">
            <div t-if="line.itz_vehicle_id" class="text-muted small">Vehicle: <span t-field="line.itz_vehicle_id.plate"/></div>
        </xpath>
        <!-- One-time versus recurring summary -->
        <xpath expr="//div[@name='so_total_summary']" position="after">
            <div class="row mt-3" t-if="doc.itz_amount_recurring" name="itz_breakdown">
                <div class="col-6">
                    <table class="table table-sm" style="font-size:0.95em;">
                        <thead><tr><th colspan="2" style="color:#0a1f44;">Summary of charges (before tax)</th></tr></thead>
                        <tbody>
                            <tr t-if="doc.itz_amount_hardware"><td>Hardware (one-time)</td><td class="text-end"><span t-out="doc.itz_amount_hardware" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr>
                            <tr t-if="doc.itz_amount_installation"><td>Installation and services (one-time)</td><td class="text-end"><span t-out="doc.itz_amount_installation" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr>
                            <tr><td>Tracking plans (recurring, first period)</td><td class="text-end"><span t-out="doc.itz_amount_recurring" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div t-if="doc.company_id.itz_payment_instructions" class="mt-3">
                <strong>How to pay</strong>
                <div t-field="doc.company_id.itz_payment_instructions"/>
            </div>
            <p t-if="doc.company_id.itz_terms_note" class="text-muted small mt-2" t-out="doc.company_id.itz_terms_note"/>
        </xpath>
    </template>
</odoo>
