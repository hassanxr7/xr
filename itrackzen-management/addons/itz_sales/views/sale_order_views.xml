<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_itz" model="ir.ui.view">
        <field name="name">sale.order.form.itz</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Invoices are created by finance users only -->
            <xpath expr="//button[@id='create_invoice']" position="attributes">
                <attribute name="groups">itz_base.group_itz_financial</attribute>
            </xpath>
            <xpath expr="//button[@id='create_invoice_percentage']" position="attributes">
                <attribute name="groups">itz_base.group_itz_financial</attribute>
            </xpath>
            <!-- Confirm only when approval is not needed or has been given -->
            <xpath expr="//button[@id='action_confirm']" position="attributes">
                <attribute name="invisible">state != 'sent' or (itz_needs_approval and itz_approval_state != 'approved')</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm'][not(@id)]" position="attributes">
                <attribute name="invisible">state != 'draft' or (itz_needs_approval and itz_approval_state != 'approved')</attribute>
            </xpath>
            <xpath expr="//button[@id='action_confirm']" position="before">
                <button name="action_itz_request_approval" type="object" string="Request approval" class="btn-primary"
                        invisible="state not in ('draft', 'sent') or not itz_needs_approval or itz_approval_state in ('pending', 'approved')"/>
                <button name="action_itz_approve" type="object" string="Approve" class="btn-success"
                        invisible="itz_approval_state != 'pending'" groups="itz_base.group_itz_approver"/>
                <button name="action_itz_reject_wizard" type="object" string="Reject"
                        invisible="itz_approval_state != 'pending'" groups="itz_base.group_itz_approver"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_itz_installations" type="object" class="oe_stat_button" icon="fa-wrench"
                        invisible="not itz_installation_count">
                    <field name="itz_installation_count" widget="statinfo" string="Installations"/>
                </button>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="itz_approval_state != 'pending'">
                    Waiting for approval from an operations manager.
                </div>
                <div class="alert alert-danger mb-0" role="alert" invisible="itz_approval_state != 'rejected'">
                    Rejected: <field name="itz_reject_reason" readonly="1" class="d-inline"/>
                </div>
                <div class="alert alert-success mb-0" role="alert" invisible="itz_approval_state != 'approved' or state not in ('draft', 'sent')">
                    Approved by <field name="itz_approved_by_id" class="d-inline"/>. You can confirm the order.
                </div>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="itz_vehicle_id" optional="show" options="{'no_create_edit': False}" context="{'default_partner_id': parent.partner_id}"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="ITrackZen" name="itz_sale">
                    <group>
                        <group string="Charges (before tax)">
                            <field name="itz_amount_hardware"/>
                            <field name="itz_amount_installation"/>
                            <field name="itz_amount_recurring"/>
                            <field name="itz_amount_other"/>
                        </group>
                        <group string="Approval">
                            <field name="itz_needs_approval"/>
                            <field name="itz_approval_state"/>
                            <field name="itz_requested_by_id"/>
                            <field name="itz_approved_by_id"/>
                            <field name="itz_approved_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="itz_vehicle_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                    <button name="action_itz_create_installation" type="object" string="Create installation jobs"
                            invisible="state != 'sale'" class="btn-secondary"
                            groups="itz_base.group_itz_sales,itz_base.group_itz_ops_manager"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_itz" model="ir.ui.view">
        <field name="name">sale.order.search.itz</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="order_line" string="Vehicle plate" filter_domain="[('order_line.itz_vehicle_id.plate', 'ilike', self)]"/>
            </xpath>
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <filter name="itz_pending_approval" string="Waiting for approval" domain="[('itz_approval_state', '=', 'pending')]"/>
                <filter name="itz_approved" string="Approved" domain="[('itz_approval_state', '=', 'approved')]"/>
            </xpath>
        </field>
    </record>

    <record id="view_quotation_tree_itz" model="ir.ui.view">
        <field name="name">sale.order.list.itz</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="itz_approval_state" widget="badge" optional="show"
                       decoration-warning="itz_approval_state == 'pending'" decoration-success="itz_approval_state == 'approved'"
                       decoration-danger="itz_approval_state == 'rejected'"/>
            </xpath>
        </field>
    </record>

    <record id="action_itz_quotations" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="domain">[('state', 'in', ('draft', 'sent', 'cancel'))]</field>
        <field name="context">{'search_default_my_quotation': 1}</field>
    </record>
    <record id="action_itz_orders" model="ir.actions.act_window">
        <field name="name">Sales Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="domain">[('state', '=', 'sale')]</field>
    </record>
    <record id="action_itz_approvals" model="ir.actions.act_window">
        <field name="name">Quotations Waiting for Approval</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('itz_approval_state', '=', 'pending')]</field>
    </record>
</odoo>
