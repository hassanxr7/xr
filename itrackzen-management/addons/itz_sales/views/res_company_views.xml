<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_itz_sales" model="ir.ui.view">
        <field name="name">res.company.form.itz.sales</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="itz_base.view_company_form_itz"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='itz_approval_threshold']" position="after">
                <field name="itz_max_discount_pct" invisible="not itz_approval_required"/>
            </xpath>
        </field>
    </record>
</odoo>
