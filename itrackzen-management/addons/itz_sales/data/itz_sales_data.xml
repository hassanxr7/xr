<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_itz_enquiry" model="ir.sequence">
        <field name="name">ITrackZen enquiry</field>
        <field name="code">itz.enquiry</field>
        <field name="prefix">ENQ/%(year)s/</field>
        <field name="padding">4</field>
    </record>
    <!-- Service products for the standard installation work. Prices are left at 0: set the approved prices in Products. -->
    <record id="product_installation_service" model="product.template">
        <field name="name">Tracker installation (labour)</field>
        <field name="itz_category">service</field>
        <field name="type">service</field>
        <field name="list_price">0.0</field>
        <field name="categ_id" ref="itz_inventory.product_category_itz_service"/>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
    </record>
    <record id="product_removal_service" model="product.template">
        <field name="name">Device removal (labour)</field>
        <field name="itz_category">service</field>
        <field name="type">service</field>
        <field name="list_price">0.0</field>
        <field name="categ_id" ref="itz_inventory.product_category_itz_service"/>
        <field name="purchase_ok" eval="False"/>
    </record>
    <record id="product_replacement_service" model="product.template">
        <field name="name">Device replacement (labour)</field>
        <field name="itz_category">service</field>
        <field name="type">service</field>
        <field name="list_price">0.0</field>
        <field name="categ_id" ref="itz_inventory.product_category_itz_service"/>
        <field name="purchase_ok" eval="False"/>
    </record>
    <record id="product_call_out_service" model="product.template">
        <field name="name">Call-out / site visit</field>
        <field name="itz_category">service</field>
        <field name="type">service</field>
        <field name="list_price">0.0</field>
        <field name="categ_id" ref="itz_inventory.product_category_itz_service"/>
        <field name="purchase_ok" eval="False"/>
    </record>
</odoo>
