<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="itz_base.group_itz_sales" model="res.groups">
        <field name="implied_ids" eval="[
            Command.link(ref('sales_team.group_sale_salesman')),
            Command.link(ref('sale.group_discount_per_so_line')),
            Command.link(ref('sale_management.group_sale_order_template'))]"/>
    </record>
    <record id="itz_base.group_itz_ops_manager" model="res.groups">
        <field name="implied_ids" eval="[
            Command.link(ref('sales_team.group_sale_manager')),
            Command.link(ref('sale.group_discount_per_so_line')),
            Command.link(ref('sale_management.group_sale_order_template'))]"/>
    </record>
    <!-- Sales officers only see invoices of their own orders; finance and read-only roles see all -->
    <record id="rule_account_move_salesman" model="ir.rule">
        <field name="name">Sales officer: invoices of own orders</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[('invoice_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="rule_account_move_financial" model="ir.rule">
        <field name="name">Finance: all invoices</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('itz_base.group_itz_financial')), Command.link(ref('account.group_account_readonly')), Command.link(ref('account.group_account_invoice'))]"/>
    </record>
    <record id="rule_account_move_line_salesman" model="ir.rule">
        <field name="name">Sales officer: invoice lines of own orders</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="domain_force">[('move_id.invoice_user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="rule_account_move_line_financial" model="ir.rule">
        <field name="name">Finance: all journal items</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('itz_base.group_itz_financial')), Command.link(ref('account.group_account_readonly')), Command.link(ref('account.group_account_invoice'))]"/>
    </record>

    <!-- Enquiries: sales and support see their own, managers see everything -->
    <record id="rule_itz_enquiry_own" model="ir.rule">
        <field name="name">Enquiries: own or unassigned</field>
        <field name="model_id" ref="model_itz_enquiry"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="groups" eval="[Command.link(ref('itz_base.group_itz_sales')), Command.link(ref('itz_base.group_itz_support'))]"/>
    </record>
    <record id="rule_itz_enquiry_all" model="ir.rule">
        <field name="name">Enquiries: managers see all</field>
        <field name="model_id" ref="model_itz_enquiry"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('itz_base.group_itz_ops_manager')), Command.link(ref('itz_base.group_itz_readonly'))]"/>
    </record>
</odoo>
