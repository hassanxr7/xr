<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="itz_reject_wizard_form" model="ir.ui.view">
        <field name="name">itz.reject.wizard.form</field>
        <field name="model">itz.reject.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="order_id" invisible="1"/>
                <group><field name="reason" placeholder="Why is this quotation rejected?"/></group>
                <footer>
                    <button name="action_confirm" type="object" string="Reject quotation" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
