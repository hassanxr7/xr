<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_form_itz" model="ir.ui.view">
        <field name="name">hr.employee.form.itz</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_issued_devices" type="object" class="oe_stat_button" icon="fa-microchip"
                        invisible="not itz_is_technician" groups="itz_base.group_itz_storekeeper,hr.group_hr_user">
                    <field name="itz_issued_count" widget="statinfo" string="Equipment in hand"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="ITrackZen" name="itz_employee" groups="hr.group_hr_user">
                    <group>
                        <group string="Role in the business">
                            <field name="itz_is_technician"/>
                            <field name="itz_stock_location_id" invisible="not itz_is_technician"/>
                        </group>
                        <group string="Responsibilities">
                            <field name="itz_responsibilities" nolabel="1" placeholder="What this person is responsible for"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
