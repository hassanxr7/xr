<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="itz_device_event_list" model="ir.ui.view">
        <field name="name">itz.device.event.list</field>
        <field name="model">itz.device.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/><field name="lot_id"/><field name="product_id" optional="hide"/>
                <field name="event_type"/><field name="old_state" optional="hide"/><field name="new_state"/>
                <field name="technician_id"/><field name="user_id"/><field name="note"/>
            </list>
        </field>
    </record>
    <record id="itz_device_event_form" model="ir.ui.view">
        <field name="name">itz.device.event.form</field>
        <field name="model">itz.device.event</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet><group>
                    <group><field name="lot_id"/><field name="date"/><field name="event_type"/><field name="user_id"/></group>
                    <group><field name="old_state"/><field name="new_state"/><field name="technician_id"/><field name="picking_id"/></group>
                </group><field name="note"/></sheet>
            </form>
        </field>
    </record>
    <record id="itz_device_event_search" model="ir.ui.view">
        <field name="name">itz.device.event.search</field>
        <field name="model">itz.device.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="lot_id" string="IMEI / Serial" filter_domain="['|', ('lot_id.name', 'ilike', self), ('lot_id.itz_imei', 'ilike', self)]"/>
                <field name="technician_id"/>
                <filter name="f_inst" string="Installs" domain="[('event_type', '=', 'install')]"/>
                <filter name="f_rem" string="Removals and replacements" domain="[('event_type', 'in', ('remove', 'replace', 'move'))]"/>
                <filter name="f_stock" string="Stock movements" domain="[('event_type', 'in', ('received', 'issue', 'return'))]"/>
                <group expand="0" string="Group By">
                    <filter name="g_type" string="Event" context="{'group_by': 'event_type'}"/>
                    <filter name="g_day" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_itz_device_events" model="ir.actions.act_window">
        <field name="name">Device History</field>
        <field name="res_model">itz.device.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
