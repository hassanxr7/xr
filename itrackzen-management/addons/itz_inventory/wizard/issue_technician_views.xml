<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="itz_issue_technician_form" model="ir.ui.view">
        <field name="name">itz.issue.technician.form</field>
        <field name="model">itz.issue.technician</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="mode" widget="radio" options="{'horizontal': true}"/>
                        <field name="technician_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="warehouse_id" options="{'no_create': True}" groups="stock.group_stock_multi_warehouses"/>
                        <field name="note"/>
                    </group>
                </group>
                <field name="lot_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Scan or type IMEI / serial numbers to add several at once..."
                       domain="[('itz_category', '!=', False)]"/>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="tracking" column_invisible="1"/>
                        <field name="lot_id" options="{'no_create': True}" required="tracking != 'none'" column_invisible="False"/>
                        <field name="quantity"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm and validate transfer" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_itz_issue_technician" model="ir.actions.act_window">
        <field name="name">Issue / Return Technician Equipment</field>
        <field name="res_model">itz.issue.technician</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="action_itz_technician_transfers" model="ir.actions.act_window">
        <field name="name">Technician Transfers</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('itz_kind', '!=', False)]</field>
    </record>
</odoo>
