; ITrackZen Management System - production Odoo configuration (generated by install-ubuntu.sh)
[options]
addons_path = __ODOO_HOME__/odoo/addons,__ODOO_HOME__/odoo/odoo/addons,__ODOO_HOME__/addons
data_dir = /var/lib/itrackzen/odoo
db_host = 127.0.0.1
db_port = 5432
db_user = itrackzen
db_password = __DB_PASSWORD__
db_name = __DB_NAME__
dbfilter = ^__DB_NAME__$
list_db = False
admin_passwd = __MASTER_PASSWORD__
; Behind nginx. Odoo only listens on localhost.
http_interface = 127.0.0.1
http_port = 8069
gevent_port = 8072
proxy_mode = True
workers = 4
max_cron_threads = 1
limit_memory_soft = 2147483648
limit_memory_hard = 2684354560
limit_time_cpu = 120
limit_time_real = 300
limit_request = 8192
log_level = info
logfile = /var/log/itrackzen/odoo.log
logrotate = True
; Outgoing email is configured in the web interface (Settings > Technical > Outgoing Mail Servers)
without_demo = all
