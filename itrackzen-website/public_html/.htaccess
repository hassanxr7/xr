# ITrackZen - Apache / LiteSpeed configuration (Hostinger, cPanel, VPS)
Options -Indexes -MultiViews
DirectoryIndex index.php index.html
AddDefaultCharset UTF-8
ServerSignature Off

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) Force HTTPS (works behind proxies/CDNs too)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2) One canonical host: www -> non-www (remove these 3 lines if you prefer www)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# 3) Never serve internal folders or secrets
RewriteRule ^(data|includes|pages|tools)(/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known) - [F,L]
RewriteRule ^includes/config\.local\.php$ - [F,L]

# 4) Dynamic sitemap
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# 5) Clean URLs: send anything that is not a real file/folder to the router
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
Header unset X-Powered-By
</IfModule>

# Compression
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml text/plain
</IfModule>

# Browser caching for static assets (URLs are versioned with ?v=...)
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Hide dotfiles
<FilesMatch "^\.">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
</FilesMatch>

