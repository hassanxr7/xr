<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: also permits plain-HTTP, so a developer can point the
  debug build at a local self-hosted server that isn't behind TLS yet
  (e.g. `http://192.168.1.20:3001`) without installing a CA cert first.
  This file lives under src/debug/res and is never merged into a release
  build — release always uses the strict config in src/main/res.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
