# Demo Betting server settings. Put real values in your host's environment / secret store,
# never in this file and never in the browser code.

# Port the server listens on
PORT=8080

# Public HTTPS address where this site is reachable. SovaMoney sends payment notifications to
# $PUBLIC_URL/payments/sovamoney/ipn and returns customers to $PUBLIC_URL/payments/success|cancel
PUBLIC_URL=https://your-demo-domain.example

# Merchant keys from the SovaMoney dashboard (API Key menu). You can instead enter them on the
# /admin page, which stores them server-side and takes precedence over these values.
SOVAMONEY_PUBLIC_KEY=
SOVAMONEY_SECRET_KEY=

# Only "sandbox" is supported in this build
SOVAMONEY_MODE=sandbox
SOVAMONEY_CURRENCY=USD

# Optional
# SOVAMONEY_SITE_LOGO=https://your-demo-domain.example/img/logo.png
# SOVAMONEY_CHECKOUT_THEME=dark          # dark | light
# SOVAMONEY_ENCODING=multipart           # multipart (default) | form | json
# DATA_DIR=/var/lib/demo-betting          # where deposits.json and settings.json are kept
# TRUST_PROXY=1                          # behind a reverse proxy that sets X-Forwarded-For
