# --- Required for production (Hostinger "Environment variables", systemd, or docker-compose) ---
NODE_ENV=production
# Persistent folder for the database, uploads and backups. MUST be outside the app folder so a redeploy does not erase it.
DATA_DIR=/home/YOUR_HOSTING_USER/bizsuite-data
HTTPS=1
TRUST_PROXY=1
SEED_DEMO=0
# --- First start only: creates the owner (+ Rio Berber, Rio Store, Reyxaan Store). Delete OWNER_PASSWORD after the first login. ---
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-Strong-Pass-1
ORG_NAME=Hubdex Store LTD
# --- Optional ---
REQUIRE_2FA=0
BACKUP_KEEP=14
# Docker + Caddy only (docker-compose.yml):
# DOMAIN=riostore.shop
# ACME_EMAIL=you@example.com
