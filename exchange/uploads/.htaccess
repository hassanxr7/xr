# Uploaded images only — no scripts may run from here.
Options -Indexes -ExecCGI
<FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|shtml|html?|js|svg|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
