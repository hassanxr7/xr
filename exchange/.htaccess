# Hufan Exchange — Apache / LiteSpeed (Hostinger) configuration
Options -Indexes
DirectoryIndex index.php

# Serve the dynamic robots.txt / sitemap.xml at their conventional URLs
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# Compress text-based responses (faster loads on mobile/slow connections)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript application/json image/svg+xml
</IfModule>

# Block hidden files and files that must never be downloaded
<FilesMatch "(^\.|\.(sql|sqlite|sqlite3|db|db-wal|db-shm|sqlite-wal|sqlite-shm|md|lock|log|ini|sh|bak|dist|example)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Force HTTPS — remove the "#" signs once SSL is active (hPanel → Security → SSL).
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>
