app/storage/cron.lock
app/storage/cache/*
app/storage/logs/*
app/storage/photos/*
app/storage/geoip/*
uploads/*
!app/storage/**/.gitkeep
!uploads/.gitkeep
!uploads/.htaccess
app/storage/newsroom.lock
